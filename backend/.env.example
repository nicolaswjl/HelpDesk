# Banco local. Para PostgreSQL, use uma URL postgresql+psycopg://...
DATABASE_URL=sqlite:///./helpdesk.db
# Gere uma chave aleatória forte antes de qualquer implantação.
SECRET_KEY=troque-por-uma-chave-aleatoria-longa
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ENVIRONMENT=development
# Limite de tentativas de login falhas por IP + e-mail (janela em segundos).
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900
